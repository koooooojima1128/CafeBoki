{
  "name": "boki-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "export:web": "expo export --platform web",
    "build:web": "expo export --platform web && node scripts/post-export.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.7",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.3",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.3",
    "expo-router": "~4.0.6",
    "expo-sharing": "~13.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "html2canvas": "^1.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-view-shot": "~4.0.3",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "sharp": "^0.35.4",
    "typescript": "~5.3.3"
  }
}
